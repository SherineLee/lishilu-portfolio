{
  "name": "lishilu-portfolio",
  "account_id": "f951127578e7c0d2423525da353af3fe",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/api/knowledge/*.md"
      ],
      "fallthrough": true
    }
  ]
}
